{
  "name": "obsidian-color-tags",
  "version": "1.0.0",
  "description": "Tag folders and notes with the seven macOS Finder colors, right from the file explorer's context menu.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": ["obsidian", "obsidian-plugin", "finder", "tags", "colors"],
  "author": "Markos Narinian",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/markosnarinian/obsidian-color-tags.git" },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.20.0",
    "obsidian": "latest",
    "tslib": "^2.6.2",
    "typescript": "^5.3.3"
  }
}
